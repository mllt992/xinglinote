APP_SECRET=change-me-to-a-long-random-string
PUBLIC_URL=http://127.0.0.1:12098
API_PORT=12099
# 数据库凭据：compose 起 db 服务和应用连库都读这几个，不要写死在 docker-compose.yml 里
POSTGRES_USER=your-db-user
POSTGRES_PASSWORD=your-db-password
POSTGRES_DB=your-db-name
# 宿主机映射端口，5432 被别的实例占用时改这里
POSTGRES_HOST_PORT=5432
# 与上面三项保持一致；连自建/外部实例时按实际填写
DATABASE_URL=postgres://your-db-user:your-db-password@127.0.0.1:5432/your-db-name
# 相对路径按仓库根解析（不是按进程 cwd）：api 与 worker 必须落在同一个 data 目录
DATA_DIR=./data
