APP_SECRET=change-me-to-a-long-random-string
PUBLIC_URL=http://127.0.0.1:12098
API_PORT=12099

# ── 数据库 ────────────────────────────────────────────────────────────────
# 连哪个 Postgres 只看这一个变量，用自建的、云上托管的、还是仓库自带的都行。
# 代码里没有兜底默认值（apps/api/src/env.ts），不配就直接报错——
# 宁可起不来，也好过悄悄连到别的库上。
DATABASE_URL=postgres://your-db-user:your-db-password@127.0.0.1:5432/your-db-name

# 容器里的进程怎么连库。不配就回落到上面的 DATABASE_URL，数据库有真实主机名时这样就够了。
# 只有当 DATABASE_URL 写的是 127.0.0.1 —— 在容器里那指的是容器自己，不是宿主机 ——
# 才必须单独配这个，指向数据库的实际地址。仅 docker compose --profile app 部署时用得上。
#DATABASE_URL_INTERNAL=postgres://your-db-user:your-db-password@your-db-host:5432/your-db-name

# ── 以下三项只在使用仓库自带的数据库时才需要 ────────────────────────────────
# 即叠加 compose.db.yml 的那条路（pnpm db:up）。接自己的数据库可以整段删掉。
# 自带库会按这三项建库，请让上面的 DATABASE_URL 与之对应。
POSTGRES_USER=your-db-user
POSTGRES_PASSWORD=your-db-password
POSTGRES_DB=your-db-name
# 自带库映射到宿主机的端口。机器上已有别的 Postgres 占着 5432 时改这里错开。
POSTGRES_HOST_PORT=5432

# 相对路径按仓库根解析（不是按进程 cwd）：api 与 worker 必须落在同一个 data 目录
DATA_DIR=./data

# ── 可选：部署形态相关 ──────────────────────────────────────────────────────
# 前端构建产物的位置。api 进程会顺带托管它；开发态由 vite 提供，不用管。
#WEB_DIST=apps/web/dist

# 后台任务的轮询间隔（毫秒）。默认 5000。
#WORKER_INTERVAL_MS=5000

# ── 可选：embedding 缓存 ──────────────────────────────────────────────────
# 不配也能跑，问答 / 重建索引走进程内 LRU。
# 配了之后 api 与 worker 共用，改几个字重索引时没变的块不再打 embedding API。
# 本地可用 pnpm redis:up（叠加 compose.redis.yml），端口被占时改 REDIS_HOST_PORT。
# 已有外部 Redis（带密码）时不要起仓库自带的，只写地址：
#   requirepass：     REDIS_URL=redis://:密码@127.0.0.1:6379
#   Redis 6 ACL：     REDIS_URL=redis://用户名:密码@127.0.0.1:6379
# 密码里有 @ : / # 时不要塞进 URL，改用 REDIS_PASSWORD。
#REDIS_URL=redis://127.0.0.1:6379
#REDIS_PASSWORD=
#REDIS_HOST_PORT=6379

# 反代层数。不配的话按「对端是不是私网地址」自动判断：
# 前面挂着本机 Caddy/Nginx 时会信任 X-Forwarded-For 的最后一跳，直连时整段忽略。
# 只有反代不止一层（比如 CDN → Nginx → api）才需要显式写成 2、3。
# 配错会让登录限流、验证码限流按错误的 IP 分桶，宁可不配。
#TRUST_PROXY_HOPS=1

# 允许服务端向内网地址发起出站请求（AI 提供商、审核模型、备份目标）。
# 默认禁止：这三处的 URL 都是用户填的，不挡就是一个现成的 SSRF 入口
# （云厂商元数据在 169.254.169.254）。内网自建模型/备份服务器才打开。
#ALLOW_PRIVATE_OUTBOUND_ENDPOINTS=true

# 带 TLS 部署时 Caddy 要用的域名（docker compose --profile tls）。
#KB_DOMAIN=kb.example.com

# 构建镜像时 npm / pnpm 用哪个源。只在 docker compose build 时起作用，跟运行无关。
# 默认官方源；国内网络差再换镜像源（实测一台国内 NAS：官方 88 KB/s vs npmmirror 5.5 MB/s，
# 不换的话 pnpm install 会一直重试到超时、构建直接失败）。
#NPM_REGISTRY=https://registry.npmmirror.com
